#!/usr/bin/env bash
# bash_profile - bash 登录壳入口
# macOS 的 bash 登录壳优先读取 ~/.bash_profile，不会自动读取 ~/.profile。
# 这里显式串起公共环境与交互配置，避免 login / non-login 行为不一致。

export __BASH_PROFILE_LOADED=1

if [[ -f "$HOME/.profile" ]]; then
  source "$HOME/.profile"
fi

if [[ -f "$HOME/.bashrc" ]]; then
  source "$HOME/.bashrc"
fi
