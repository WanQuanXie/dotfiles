# 非 login 的交互 bash 也需要补齐公共环境。
if [[ -z "${__BASH_PROFILE_LOADED:-}" ]] && [[ -f "$HOME/.profile" ]]; then
  source "$HOME/.profile"
fi

if [[ $- == *i* ]]; then
  # 提示符与目录跳转工具
  command -v starship >/dev/null 2>&1 && eval "$(starship init bash)"
  command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"

  # fnm
  command -v fnm >/dev/null 2>&1 && eval "$(fnm env --use-on-cd --corepack-enabled --resolve-engines --shell bash)"

  # OpenClaw completion
  [[ -f "$HOME/.openclaw/completions/openclaw.bash" ]] && source "$HOME/.openclaw/completions/openclaw.bash"

  # 交互别名（可选文件，不存在时跳过）
  [[ -f "$HOME/.bash_aliases" ]] && source "$HOME/.bash_aliases"
fi
